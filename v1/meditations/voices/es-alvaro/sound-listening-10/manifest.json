{
  "id": "sound-listening-10",
  "voiceId": "es-alvaro",
  "edgeVoice": "es-ES-AlvaroNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 186,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.048
    },
    {
      "index": 1,
      "text": "Tómese el tiempo para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.368
    },
    {
      "index": 2,
      "text": "Siéntate o acuéstate con apoyo.",
      "file": "c002.ogg",
      "durationSec": 5.16
    },
    {
      "index": 3,
      "text": "Cierra los ojos si te sientes seguro.",
      "file": "c003.ogg",
      "durationSec": 5.28
    },
    {
      "index": 4,
      "text": "Siente el contacto con el suelo.",
      "file": "c004.ogg",
      "durationSec": 4.872
    },
    {
      "index": 5,
      "text": "Inhale lentamente.",
      "file": "c005.ogg",
      "durationSec": 3.744
    },
    {
      "index": 6,
      "text": "Exhale más tiempo.",
      "file": "c006.ogg",
      "durationSec": 3.768
    },
    {
      "index": 7,
      "text": "[pausa:23]",
      "file": "c007.ogg",
      "durationSec": 4.32
    },
    {
      "index": 8,
      "text": "De nuevo.",
      "file": "c008.ogg",
      "durationSec": 2.904
    },
    {
      "index": 9,
      "text": "[pausa:23]",
      "file": "c009.ogg",
      "durationSec": 4.32
    },
    {
      "index": 10,
      "text": "Deja caer los hombros.",
      "file": "c010.ogg",
      "durationSec": 4.128
    },
    {
      "index": 11,
      "text": "Deja que la barriga se ablande.",
      "file": "c011.ogg",
      "durationSec": 4.56
    },
    {
      "index": 12,
      "text": "[pausa:29]",
      "file": "c012.ogg",
      "durationSec": 4.296
    },
    {
      "index": 13,
      "text": "Abre los oídos.",
      "file": "c013.ogg",
      "durationSec": 3.48
    },
    {
      "index": 14,
      "text": "Observe el sonido más cercano.",
      "file": "c014.ogg",
      "durationSec": 4.848
    },
    {
      "index": 15,
      "text": "[pausa:29]",
      "file": "c015.ogg",
      "durationSec": 4.296
    },
    {
      "index": 16,
      "text": "Observe el sonido más lejano que pueda escuchar.",
      "file": "c016.ogg",
      "durationSec": 6.12
    },
    {
      "index": 17,
      "text": "[pausa:29]",
      "file": "c017.ogg",
      "durationSec": 4.296
    },
    {
      "index": 18,
      "text": "Note el silencio entre los sonidos.",
      "file": "c018.ogg",
      "durationSec": 5.04
    },
    {
      "index": 19,
      "text": "[pausa:35]",
      "file": "c019.ogg",
      "durationSec": 4.512
    },
    {
      "index": 20,
      "text": "Los sonidos surgen y pasan. No es necesario nombrarlos.",
      "file": "c020.ogg",
      "durationSec": 9.12
    },
    {
      "index": 21,
      "text": "El oído oye.",
      "file": "c021.ogg",
      "durationSec": 3.36
    },
    {
      "index": 22,
      "text": "[pausa:47]",
      "file": "c022.ogg",
      "durationSec": 4.488
    },
    {
      "index": 23,
      "text": "Cuando la mente divaga, vuelve a escuchar.",
      "file": "c023.ogg",
      "durationSec": 5.616
    },
    {
      "index": 24,
      "text": "[pausa:35]",
      "file": "c024.ogg",
      "durationSec": 4.512
    },
    {
      "index": 25,
      "text": "Incluye el sonido de tu propia respiración.",
      "file": "c025.ogg",
      "durationSec": 5.592
    },
    {
      "index": 26,
      "text": "[pausa:35]",
      "file": "c026.ogg",
      "durationSec": 4.512
    },
    {
      "index": 27,
      "text": "Descanse en todo el paisaje sonoro.",
      "file": "c027.ogg",
      "durationSec": 5.448
    },
    {
      "index": 28,
      "text": "Un campo vivo de vibración.",
      "file": "c028.ogg",
      "durationSec": 4.488
    },
    {
      "index": 29,
      "text": "[pausa:90]",
      "file": "c029.ogg",
      "durationSec": 3.84
    },
    {
      "index": 30,
      "text": "Nada que resolver en la escucha.",
      "file": "c030.ogg",
      "durationSec": 4.704
    },
    {
      "index": 31,
      "text": "[pausa:70]",
      "file": "c031.ogg",
      "durationSec": 4.104
    },
    {
      "index": 32,
      "text": "[pausa:35]",
      "file": "c032.ogg",
      "durationSec": 4.512
    },
    {
      "index": 33,
      "text": "Comience a profundizar la respiración.",
      "file": "c033.ogg",
      "durationSec": 5.256
    },
    {
      "index": 34,
      "text": "Descansa aquí.",
      "file": "c034.ogg",
      "durationSec": 3.432
    },
    {
      "index": 35,
      "text": "[pausa:27]",
      "file": "c035.ogg",
      "durationSec": 4.32
    },
    {
      "index": 36,
      "text": "Siente la habitación de nuevo.",
      "file": "c036.ogg",
      "durationSec": 4.464
    },
    {
      "index": 37,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c037.ogg",
      "durationSec": 5.424
    },
    {
      "index": 38,
      "text": "Cuando esté listo, abre los ojos.",
      "file": "c038.ogg",
      "durationSec": 5.448
    },
    {
      "index": 39,
      "text": "Avance lentamente hacia lo que viene a continuación.",
      "file": "c039.ogg",
      "durationSec": 6.24
    }
  ]
}
