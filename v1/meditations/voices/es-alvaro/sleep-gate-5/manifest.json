  "chunks": [
    {
      "index": 0,
      "text": "Esta práctica es para el borde del sueño.",
      "file": "c000.ogg",
      "durationSec": 5.472
    },
    {
      "index": 1,
      "text": "Atenúa las luces. Acostarse.",
      "file": "c001.ogg",
      "durationSec": 6.84
    },
    {
      "index": 2,
      "text": "No queda nada por terminar en este momento.",
      "file": "c002.ogg",
      "durationSec": 5.568
    },
    {
      "index": 3,
      "text": "[pausa:24]",
      "file": "c003.ogg",
      "durationSec": 4.32
    },
    {
      "index": 4,
      "text": "Inhala suavemente.",
      "file": "c004.ogg",
      "durationSec": 3.888
    },
    {
      "index": 5,
      "text": "Exhala más tiempo.",
      "file": "c005.ogg",
      "durationSec": 3.768
    },
    {
      "index": 6,
      "text": "[pausa:24]",
      "file": "c006.ogg",
      "durationSec": 4.32
    },
    {
      "index": 7,
      "text": "Suelta la frente.",
      "file": "c007.ogg",
      "durationSec": 3.528
    },
    {
      "index": 8,
      "text": "Libera los ojos.",
      "file": "c008.ogg",
      "durationSec": 3.768
    },
    {
      "index": 9,
      "text": "Suelta la mandíbula.",
      "file": "c009.ogg",
      "durationSec": 3.768
    },
    {
      "index": 10,
      "text": "[pausa:29]",
      "file": "c010.ogg",
      "durationSec": 4.296
    },
    {
      "index": 11,
      "text": "Armas pesadas. Piernas pesadas.",
      "file": "c011.ogg",
      "durationSec": 6.96
    },
    {
      "index": 12,
      "text": "[pausa:29]",
      "file": "c012.ogg",
      "durationSec": 4.296
    },
    {
      "index": 13,
      "text": "Si los pensamientos te visitan, déjalos pasar como coches nocturnos.",
      "file": "c013.ogg",
      "durationSec": 8.376
    },
    {
      "index": 14,
      "text": "Te quedas con la respiración.",
      "file": "c014.ogg",
      "durationSec": 4.224
    },
    {
      "index": 15,
      "text": "[pausa:45]",
      "file": "c015.ogg",
      "durationSec": 4.512
    },
    {
      "index": 16,
      "text": "Cuerpo que se hunde.",
      "file": "c016.ogg",
      "durationSec": 3.648
    },
    {
      "index": 17,
      "text": "Respira tranquilo.",
      "file": "c017.ogg",
      "durationSec": 3.744
    },
    {
      "index": 18,
      "text": "[pausa:45]",
      "file": "c018.ogg",
      "durationSec": 4.512
    },
    {
      "index": 19,
      "text": "Si llega el sueño, déjalo.",
      "file": "c019.ogg",
      "durationSec": 4.776
    },
    {
      "index": 20,
      "text": "Si no, descansa de todos modos.",
